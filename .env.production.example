# Copy this file to .env.production on the VPS. Never commit the real file.
POSTGRES_PASSWORD="generate-a-long-random-database-password"
ADMIN_SESSION_SECRET="generate-a-random-secret-at-least-32-characters"
NEWSLETTER_TOKEN_SECRET="generate-a-different-random-secret-at-least-32-characters"
NEWSLETTER_PUBLIC_URL="https://kitsuwire.com"
ANALYTICS_RETENTION_DAYS="180"

# Brevo: fill these only after sender/domain verification.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="newsletter@kitsuwire.com"
BREVO_SENDER_NAME="KitsuWire"
BREVO_REPLY_TO_EMAIL=""

# Optional provider-neutral newsletter fallback.
NEWSLETTER_DELIVERY_WEBHOOK_URL=""
NEWSLETTER_DELIVERY_WEBHOOK_SECRET=""

# Google AdSense. Leave empty until the account/site is approved.
# Example format: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=""
