# Local database used by Prisma outside Docker Compose.
DATABASE_URL="postgresql://kitsuwire:kitsuwire_dev@localhost:5432/kitsuwire?schema=public"

# Docker Compose reads this value for the PostgreSQL container.
POSTGRES_PASSWORD="kitsuwire_dev"

# Initial admin bootstrap. ADMIN_PASSWORD is only needed when running npm run admin:create.
ADMIN_EMAIL="admin@kitsuwire.com"
ADMIN_NAME="KitsuWire Admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Use a random secret of at least 32 characters in production.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
