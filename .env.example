# Local database used by Prisma outside Docker Compose.
DATABASE_URL="postgresql://kitsuwire:kitsuwire_dev@localhost:5432/kitsuwire?schema=public"

# Docker Compose reads this value for the PostgreSQL container.
POSTGRES_PASSWORD="kitsuwire_dev"

# Initial admin bootstrap. ADMIN_PASSWORD is only needed when running npm run admin:create.
ADMIN_EMAIL="admin@kitsuwire.com"
ADMIN_NAME="KitsuWire Admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Use a random secret of at least 32 characters in production.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Newsletter double opt-in.
NEWSLETTER_PUBLIC_URL="http://localhost:3000"
# Dedicated HMAC secret for confirmation/unsubscribe flows. Falls back to ADMIN_SESSION_SECRET.
NEWSLETTER_TOKEN_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Primary email delivery: Brevo transactional email API.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="newsletter@kitsuwire.com"
BREVO_SENDER_NAME="KitsuWire"
BREVO_REPLY_TO_EMAIL=""

# Optional provider-neutral fallback. Used only when Brevo is not configured.
NEWSLETTER_DELIVERY_WEBHOOK_URL=""
NEWSLETTER_DELIVERY_WEBHOOK_SECRET=""
