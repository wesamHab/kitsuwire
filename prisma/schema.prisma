generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  IDEA
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(AUTHOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Author {
  id        String    @id @default(cuid())
  name      String    @unique
  bio       String?
  avatarUrl String?
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  label       String
  description String
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Media {
  id        String    @id @default(cuid())
  kind      MediaKind @default(IMAGE)
  filename  String
  url       String    @unique
  altText   String?
  mimeType  String?
  fileSize  Int?
  width     Int?
  height    Int?
  articles  Article[] @relation("FeaturedImage")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  excerpt         String
  seoTitle        String?
  seoDescription  String?
  body            Json            @default("[]")
  keyTakeaways    Json            @default("[]")
  readingTime     String
  tone            String          @default("green")
  featured        Boolean         @default(false)
  allowAds        Boolean         @default(true)
  status          ArticleStatus   @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId        String?
  author          Author?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredImageId String?
  featuredImage   Media?          @relation("FeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  tags            Tag[]
  sections        ArticleSection[]
  faq             ArticleFaq[]
  sources         ArticleSource[]
  revisions       ArticleRevision[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([categoryId])
  @@index([updatedAt])
}

model ArticleSection {
  id         String  @id @default(cuid())
  articleId  String
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  heading    String
  paragraphs Json    @default("[]")
  bullets    Json    @default("[]")
  position   Int

  @@unique([articleId, position])
  @@index([articleId])
}

model ArticleFaq {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int

  @@unique([articleId, position])
  @@index([articleId])
}

model ArticleSource {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  label     String
  url       String
  position  Int

  @@unique([articleId, position])
  @@index([articleId])
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  snapshot  Json
  note      String?
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}

model NewsletterSubscriber {
  id                        String    @id @default(cuid())
  email                     String    @unique
  isActive                  Boolean   @default(false)
  source                    String?
  confirmationTokenHash     String?   @unique
  confirmationSentAt        DateTime?
  lastConfirmationRequestedAt DateTime?
  confirmedAt               DateTime?
  subscribedAt              DateTime  @default(now())
  unsubscribedAt            DateTime?
  updatedAt                 DateTime  @updatedAt

  @@index([isActive, confirmedAt])
  @@index([subscribedAt])
}

model PageView {
  id           String   @id @default(cuid())
  path         String
  articleSlug  String?
  referrerHost String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([articleSlug, createdAt])
  @@index([path, createdAt])
  @@index([referrerHost, createdAt])
}
